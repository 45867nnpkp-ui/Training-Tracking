# Postgres-Verbindung. Auf Render wird der Wert automatisch aus der Datenbank
# übernommen (render.yaml), lokal z. B.:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/training

# Passwort für den Login in der App (frei wählbar).
APP_PASSWORD=bitte-aendern

# Zufälliger, langer Geheimwert zum Signieren des Login-Cookies.
# Auf Render wird er automatisch erzeugt (render.yaml -> generateValue).
# Lokal z. B. erzeugen mit: openssl rand -hex 32
SESSION_SECRET=lokal-nur-zum-testen-bitte-aendern-0123456789abcdef
